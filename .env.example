# Copie este arquivo para .env.local e preencha os valores reais.
# Nenhum valor aqui é real — são só placeholders documentando o que cada
# variável faz e de onde vem.

# --- Banco de dados (Payload) ---------------------------------------------
# Connection string do Postgres (Neon) usado pelo Payload e por todo o app.
# Pooled connection do Neon (PgBouncer) — não aceita search_path via startup
# parameter (ver app/lib/db.ts).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Payload CMS -------------------------------------------------------
# Chave usada pelo Payload pra assinar sessões/tokens de admin. Gerar um
# valor aleatório longo (ex.: openssl rand -hex 32) e nunca reaproveitar
# entre ambientes.
PAYLOAD_SECRET=

# --- Upload de mídia (Vercel Blob) ------------------------------------
# Token do Vercel Blob Storage, usado pelo plugin
# @payloadcms/storage-vercel-blob (collection `media`). Sem isso, upload
# cai no fallback de disco local (não funciona em produção serverless).
BLOB_READ_WRITE_TOKEN=

# --- Bot de missa ao vivo (YouTube Data API v3) ------------------------
# Channel ID real do canal da paróquia (não o @handle) — obtido via
# channels.list(forHandle=...) ou pela página "Sobre" do canal no YouTube.
YOUTUBE_CHANNEL_ID=
# API key do Google Cloud com a "YouTube Data API v3" habilitada. Sem
# restrição de referrer HTTP (o bot roda server-side, não no navegador).
YOUTUBE_API_KEY=
# Secret compartilhado com o agendador externo (cron-job.org) que dispara
# GET /api/cron/check-live-mass a cada 5 minutos — obrigatório em produção.
# Se rotacionar, atualizar os dois lados juntos (Vercel + cron-job.org).
CRON_SECRET=

# --- Notificações push (Web Push / VAPID) -------------------------------
# Par de chaves gerado via `npx web-push generate-vapid-keys`. A pública
# também é lida no client (por isso o prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- E-mail transacional (Resend) ---------------------------------------
# Usado por /api/intencoes pra avisar a paróquia (e uma cópia interna)
# quando alguém envia uma intenção de missa pelo site.
RESEND_API_KEY=
# Precisa ser um endereço num domínio verificado na conta Resend
# (resend.com/domains) — senão o envio é rejeitado com 403.
RESEND_FROM_EMAIL=site@seu-dominio-verificado.com.br

# --- Explicação da liturgia via IA (Groq) -------------------------------
# Usado por /api/liturgia/explicacao pra gerar a explicação pastoral do
# dia. Sem isso, a rota cai no fallback estático (ver o próprio arquivo).
GROQ_API_KEY=

# --- URL pública do site -------------------------------------------------
# Usada em metadata (og:url, canonical), sitemap.xml e robots.txt. Sem
# domínio final, com barra no final, ou o robots.txt/sitemap.xml geram
# URLs quebradas.
NEXT_PUBLIC_BASE_URL=https://www.paroquiaaltonia.com.br
